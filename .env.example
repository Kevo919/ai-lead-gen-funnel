# Server Configuration
PORT=3200
BASE_URL=http://localhost:3200

# SMTP Email Configuration (Required for sending emails)
# Leave these blank to run in development mode (emails will be logged but not sent)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key-here
FROM_EMAIL=noreply@yourdomain.com

# Alternative SMTP Providers:
# SendGrid: smtp.sendgrid.net, port 587, user: apikey
# Mailgun: smtp.mailgun.org, port 587
# Gmail: smtp.gmail.com, port 587 (requires app password)
# Amazon SES: email-smtp.us-east-1.amazonaws.com, port 587
